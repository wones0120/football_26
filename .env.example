APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

PGHOST=localhost
PGPORT=5432
PGDATABASE=football_26_dev
PGUSER=postgres
PGPASSWORD=postgres

# Optional override. If set, this takes precedence over PG* fields.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/football_26_dev

# Dev convenience: create missing tables automatically on API startup.
AUTO_CREATE_TABLES=true

# Completed persisted optimizer results: bounded cache, authoritative DB reload.
# Set max entries to 0 to disable retention. Expiration is checked on cache access.
OPTIMIZER_RESULT_CACHE_MAX_ENTRIES=1
OPTIMIZER_RESULT_CACHE_TTL_SECONDS=60

# Research-only opportunity repair. Keep legacy_v1 until chronological validation passes.
PLAYER_OPPORTUNITY_ALLOCATION_POLICY=legacy_v1
# Opt-in research value: team_window_v2 (same-team common windows, explicit unallocated work).

SHOWDOWN_CAPTAIN_MODEL_PATH=docs/showdown_captain_model_2024_2025.json
SHOWDOWN_CAPTAIN_PRIOR_STRENGTH=0.35
# Live Showdown generation fails closed on source age. Market uses the existing
# preparation six-hour fresh band; salary uses the weekly slate lifecycle.
# These are observation/cutoff ages, not sportsbook publication-time claims.
SHOWDOWN_MARKET_MAX_AGE_HOURS=6
SHOWDOWN_PROJECTION_MAX_AGE_HOURS=24
SHOWDOWN_PLAYER_STATUS_MAX_AGE_HOURS=24
SHOWDOWN_STARTING_QB_MAX_AGE_HOURS=24
SHOWDOWN_SALARY_POOL_MAX_AGE_HOURS=168
SHOWDOWN_OWNERSHIP_MAX_AGE_HOURS=24
# Live Classic Large-GPP source policies; independent of strategy weights.
CLASSIC_MARKET_MAX_AGE_HOURS=6
CLASSIC_PROJECTION_MAX_AGE_HOURS=24
CLASSIC_PLAYER_STATUS_MAX_AGE_HOURS=24
CLASSIC_SALARY_POOL_MAX_AGE_HOURS=168
CLASSIC_OWNERSHIP_MAX_AGE_HOURS=24
CLASSIC_VALUE_DRIVER_MODEL_PATH=docs/main_slate_value_driver_analysis_2024_2025.json
CLASSIC_VALUE_DRIVER_PRIOR_STRENGTH=0.45
MATCHUP_OUTCOME_MODEL_PATH=docs/matchup_outcome_intelligence_2024_2025.json
MATCHUP_OUTCOME_PRIOR_STRENGTH=0.15
MATCHUP_PRIOR_GATE_MODEL_PATH=docs/matchup_prior_gate_20slates_5000.json

# Content-addressed, immutable prospective source captures. Before live-season
# use, override this with an absolute path on backed-up durable storage.
# Verify read/write access from both API and worker processes. A file present
# locally may still be denied to the worker; the observed failure was in an
# on-disk iCloud Drive folder, not proven cloud-only storage.
# Keep working evidence outside version control; manifests and database lineage
# reference the stored files and cannot repair a lost artifact.
SOURCE_SNAPSHOT_ROOT=artifacts/source_snapshots

# Immutable historical and current weather-forecast captures. Free Open-Meteo
# access is local non-commercial evaluation only. Before live-season use,
# override this with an absolute path on backed-up durable storage readable
# by the API and worker. Production
# requires customer endpoints and a Professional-or-higher API key under
# weather_forecast_source_contract_v1.
WEATHER_FORECAST_SNAPSHOT_ROOT=artifacts/weather_forecasts
WEATHER_FORECAST_PROVIDER=open_meteo_previous_runs
OPEN_METEO_BASE_URL=https://previous-runs-api.open-meteo.com/v1/forecast
CURRENT_WEATHER_FORECAST_PROVIDER=open_meteo_forecast
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=
OPEN_METEO_MODEL=ncep_gfs_seamless
OPEN_METEO_FIXED_LEAD_HOURS=24
OPEN_METEO_MIN_REQUEST_INTERVAL_SECONDS=0.11
WEATHER_FORECAST_REFRESH_INTERVAL_MINUTES=60
WEATHER_FORECAST_STALE_AFTER_MINUTES=120

# Verified DST input sidecars only; this never activates a candidate model.
DST_FEATURE_SUPPORT_MANIFEST_PATH=
DST_FEATURE_SUPPORT_MANIFEST_SHA256=
DST_FEATURE_SUPPORT_OUTPUT_ROOT=artifacts/dst_feature_support

# Optional accepted DST forecast component. Empty retains the incumbent.
# Pin an explicitly approved selection manifest; pending/invalid/expired selections fail Prepare.
DST_DEPLOYMENT_MANIFEST_PATH=
DST_DEPLOYMENT_MANIFEST_SHA256=
